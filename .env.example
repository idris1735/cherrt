# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI
GEMINI_API_KEY=your-gemini-api-key

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token

# App
NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app

# Email codes (Resend) — onboarding sends the code to email AND WhatsApp.
# Without RESEND_API_KEY the WhatsApp channel still delivers (never blocks onboarding).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM="Chertt <donotreply@yourdomain.com>"  # must be a domain verified in Resend

# Mono (CAC + NIN lookup during KYC) — https://api.withmono.com
MONO_SECRET_KEY=your-mono-secret-key

# Platform admins (comma-separated emails/phones for the admin console + approvals)
PLATFORM_ADMIN_EMAILS=you@yourdomain.com
PLATFORM_ADMIN_PHONES=+2348000000000

# Security
CRON_SECRET=your-cron-secret
