# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI
GEMINI_API_KEY=your-gemini-api-key

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token

# WhatsApp message templates. Business-initiated messages OUTSIDE the 24h
# session window REQUIRE a Meta-approved template — otherwise the plain-text
# fallback is blocked and (e.g.) an approved founder is never notified. Set
# these to your approved template names. See docs/kyc-whatsapp-templates.md.
WHATSAPP_TEMPLATE_ORG_APPROVED=chertt_org_approved
WHATSAPP_TEMPLATE_ORG_REJECTED=chertt_org_rejected
WHATSAPP_TEMPLATE_NEW_SIGNUP=chertt_new_signup_alert

# App
NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app

# Email codes (Resend) — onboarding sends the code to email AND WhatsApp.
# Without RESEND_API_KEY the WhatsApp channel still delivers (never blocks onboarding).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM="Chertt <donotreply@yourdomain.com>"  # must be a domain verified in Resend

# Email codes via SMTP (PRIMARY — e.g. Hostinger mailbox; works without Resend).
# SMTP is tried first, Resend second, WhatsApp always. All three optional.
SMTP_HOST=smtp.yourmailhost.com
SMTP_PORT=465
SMTP_USER=donotreply@yourdomain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM="Chertt <donotreply@yourdomain.com>"

# Mono (CAC + NIN lookup during KYC) — https://api.withmono.com
MONO_SECRET_KEY=your-mono-secret-key

# Platform admins (comma-separated emails/phones for the admin console + approvals)
PLATFORM_ADMIN_EMAILS=you@yourdomain.com
PLATFORM_ADMIN_PHONES=+2348000000000

# Payments (giving) — Paystack. Unset = demo mode (no real charge; the /pay
# demo checkout records giving so the flow is fully testable without keys).
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Subscription billing is a PLACEHOLDER (no real charge). Demo activation via
# /api/billing/activate is OFF in production unless this is exactly "true".
ALLOW_DEMO_BILLING=false

# Security
CRON_SECRET=your-cron-secret
